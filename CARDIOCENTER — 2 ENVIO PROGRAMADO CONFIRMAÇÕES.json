    {
      "parameters": {
        "jsCode": "const telefone = $('Loop Over Items').item.json.telefone || '';\nconst dataHoje = $now.toFormat('yyyyMMdd');\nconst dados = JSON.stringify({\n  nome: $('Loop Over Items').item.json.nome,\n  data: $('Loop Over Items').item.json.data,\n  resumo: $('Loop Over Items').item.json.resumo,\n  telefone: telefone\n});\n\nconst m = telefone.match(/^55(\\d{2})9(\\d{8})$/);\nconst telefoneSem9 = m ? `55${m[1]}${m[2]}` : null;\n\nconst chaves = [telefone];\nif (telefoneSem9 && telefoneSem9 !== telefone) chaves.push(telefoneSem9);\n\nreturn chaves.map(tel => ({\n  json: {\n    sessionKey: `${tel}_${dataHoje}`,\n    dadosConfirmacaoPendente: dados\n  }\n}));"
      },
