      "parameters": {
        "jsCode": "// Calcula o tempo de espera APOS cada envio:\n// - 60s entre mensagens dentro do mesmo bloco\n// - 15min (900s) ao fechar um bloco de 10\n// - 0s se for a ultima mensagem da fila (nao precisa esperar mais nada)\nconst items = $input.all();\nconst total = items.length;\n\nreturn items.map((item, idx) => {\n  let espera;\n  if (idx === total - 1) {\n    espera = 0;\n  } else {\n    const fechaBloco = (idx + 1) % 10 === 0;\n    espera = fechaBloco ? 900 : 60;\n  }\n  return { json: { ...item.json, esperaAposEnvio: espera, posicaoFila: idx + 1, totalFila: total, bloco: Math.ceil((idx + 1) / 10) } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -752,
        464
