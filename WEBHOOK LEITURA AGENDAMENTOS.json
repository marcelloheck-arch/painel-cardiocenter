        "operation": "executeQuery",
        "query": "UPDATE agendamentos \nSET status = 'em_atendimento', \n    atendente = '{{ $('Coleta acao').item.json.atendente }}',\n    updated_at = NOW() \nWHERE id = {{ $('Coleta acao').item.json.id }} \nAND status = 'pendente' \nRETURNING id, status",
