    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n// Se retornou linha, conseguiu assumir. Se não retornou, já foi assumido por outra pessoa.\nif (rows.length > 0 && rows[0].json.id) {\n  return [{ json: { success: true, acao: 'assumir', mensagem: 'Atendimento assumido com sucesso!' } }];\n} else {\n  return [{ json: { success: false, acao: 'assumir', mensagem: 'Esta conversa já foi assumida por outra atendente. Passe para a próxima.' } }];\n}"
